module Test;

import Std::{
    Array, F64, IO, String, Array::@, Debug::assert, F64::abs, IO::{exit_with_msg, println, IOFail::try}, 
    Monad::pure, Option::{as_some, is_none}, Result::as_ok, ToF64::f64, ToI64::i64, ToString::to_string
};
import Time::{
    from_local, from_utc, get_now, to_local, to_utc, DateTime, 
    DateTime::{@day_in_month, @day_in_week, @hour, @is_dst, @min, @month, @nanosec, @sec, @year}, 
    Time::{@nanosec, @sec}
}; 

weeks : Array String;
weeks = ["Sun", "Mon", "Tue", "Wed", "Thr", "Fri", "Sat"];

dt_to_string : DateTime -> String;
dt_to_string = |dt| (
    dt.@year.to_string + "/" + dt.@month.to_string + "/" + dt.@day_in_month.to_string + " (" + weeks.@(dt.@day_in_week.i64) + ") " +
    dt.@hour.to_string + ":" + dt.@min.to_string + ":" +
    (dt.@sec.f64 + 1.0e-9 * dt.@nanosec.f64).to_string +
    ", dst = " + 
    if dt.@is_dst.is_none { "none" } else { dt.@is_dst.as_some.to_string }
);

test : IO ();
test = (
    let now = *get_now;
    println $ "now.sec = " + now.@sec.to_string + ", now.nanosec = " + now.@nanosec.to_string;;
    let utc = now.to_utc.as_ok;
    println $ "UTC: " + dt_to_string(utc);;
    let loc = *now.to_local.try(exit_with_msg(1));
    println $ "Loc: " + dt_to_string(loc);;
    let now_from_utc = Time::from_utc(utc).as_ok;
    let now_from_loc = *Time::from_local(loc).try(exit_with_msg(1));
    assert(|_|"diff utc", (now.f64 - now_from_utc.f64).abs < 0.1);;
    assert(|_|"diff loc", (now.f64 - now_from_loc.f64).abs < 0.1);;

    pure()
);